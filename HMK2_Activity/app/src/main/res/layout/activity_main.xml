<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_start"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:textSize="24dp"
        android:gravity="center_vertical|start"
        android:text="點餐:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"/>

    <Button
        android:id="@+id/bt_start"
        android:layout_width="84dp"
        android:layout_height="48dp"
        android:textSize="16dp"
        android:gravity="center"
        android:text="選擇"
        app:layout_constraintTop_toTopOf="@+id/tv_start"
        app:layout_constraintStart_toEndOf="@+id/tv_start"/>

    <TextView
        android:id="@+id/tv_showtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        android:gravity="center"
        android:text="確認餐點:"
        app:layout_constraintStart_toStartOf="@+id/tv_start"
        app:layout_constraintTop_toBottomOf="@+id/tv_start"
        android:layout_marginTop="48dp"/>

    <TextView
        android:id="@+id/tv_showmeal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:text="飲料: 無\n甜度: 無\n冰塊: 無"
        app:layout_constraintTop_toBottomOf="@id/tv_showtitle"
        app:layout_constraintStart_toStartOf="@id/tv_showtitle"/>

</androidx.constraintlayout.widget.ConstraintLayout>