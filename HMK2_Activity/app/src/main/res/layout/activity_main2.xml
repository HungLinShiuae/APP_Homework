<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">

    <TextView
        android:id="@+id/tv_beverage"
        android:layout_width="72dp"
        android:layout_height="48dp"
        android:textSize="24dp"
        android:gravity="center_vertical|start"
        android:text="飲料:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"/>

    <EditText
        android:id="@+id/et_beverage"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:ems="10"
        android:hint="請輸入飲料名稱"
        android:inputType="textPersonName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_beverage"
        android:layout_marginTop="16dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>

    <TextView
        android:id="@+id/tv_sugar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        android:text="甜度:"
        app:layout_constraintStart_toStartOf="@+id/et_beverage"
        app:layout_constraintTop_toBottomOf="@+id/et_beverage"
        android:layout_marginTop="16dp"/>

    <RadioGroup
        android:id="@+id/rg_sugar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@+id/tv_sugar"
        app:layout_constraintTop_toBottomOf="@+id/tv_sugar">
        <RadioButton
            android:id="@+id/sugar_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="無糖"/>
        <RadioButton
            android:id="@+id/sugar_little"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="少糖"/>
        <RadioButton
            android:id="@+id/sugar_half"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="半糖"/>
        <RadioButton
            android:id="@+id/sugar_full"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="全糖"/>
    </RadioGroup>

    <TextView
        android:id="@+id/tv_ice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        android:text="冰塊:"
        app:layout_constraintStart_toStartOf="@+id/rg_sugar"
        app:layout_constraintTop_toBottomOf="@+id/rg_sugar"
        android:layout_marginTop="8dp"/>

    <RadioGroup
        android:id="@+id/rg_ice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="@+id/tv_ice"
        app:layout_constraintTop_toBottomOf="@+id/tv_ice">
        <RadioButton
            android:id="@+id/ice_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="true"
            android:text="去冰"/>
        <RadioButton
            android:id="@+id/ice_little"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="微冰"/>
        <RadioButton
            android:id="@+id/ice_half"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="少冰"/>
        <RadioButton
            android:id="@+id/ice_full"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="正常冰"/>
    </RadioGroup>

    <Button
        android:id="@+id/bt_send"
        android:layout_width="84dp"
        android:layout_height="48dp"
        android:textSize="16dp"
        android:gravity="center"
        android:text="送出"
        app:layout_constraintTop_toBottomOf="@+id/rg_ice"
        app:layout_constraintStart_toStartOf="@+id/rg_ice"
        android:layout_marginTop="8dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>